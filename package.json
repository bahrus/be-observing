{
  "name": "be-observing",
  "version": "0.0.5",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "JSON",
    "bind",
    "observe"
  ],
  "description": "Glue DOM and custom elements together mostly declaratively.",
  "main": "be-observing.js",
  "module": "be-observing.js",
  "exports": {
    ".": "./be-observing.js",
    "./be-observing.js": "./be-observing.js",
    "./🔭.js": "./🔭.js"
  },
  "scripts": {
    "build": "node emc.mjs > emc.json && node 🔭.mjs > 🔭.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "types": "./types/be-observing/types.d.ts",
  "dependencies": {
    "be-hive": "0.1.14",
    "inferencer": "0.0.13",
    "mount-observer": "0.1.40",
    "roundabout-lib": "0.0.21",
    "nested-regex-groups": "0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "be-eventing": "0.0.5",
    "spa-ssi": "0.0.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-observing.git"
  },
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/be-observing/issues"
  },
  "homepage": "https://github.com/bahrus/be-observing#readme"
}
